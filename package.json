{
    "name": "create-fivem-res",
    "version": "1.0.2",
    "publishConfig": {
        "access": "public"
    },
    "description": "A CLI tool to quickly scaffold new FiveM resources with TypeScript.",
    "type": "module",
    "bin": {
        "create-fivem-res": "./dist/index.js"
    },
    "files": [
        "dist",
        "templates"
    ],
    "scripts": {
        "build": "tsc",
        "dev": "tsc --watch",
        "prepublishOnly": "bun run build",
        "test": "bun dist/index.js",
        "format": "prettier --write .",
        "lint": "prettier --check ."
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/tfxhub/create-fivem-res.git"
    },
    "keywords": [
        "fivem",
        "gta5",
        "typescript",
        "cli",
        "scaffold"
    ],
    "author": "ianram0s",
    "license": "MIT",
    "bugs": {
        "url": "https://github.com/tfxhub/create-fivem-res/issues"
    },
    "homepage": "https://github.com/tfxhub/create-fivem-res#readme",
    "dependencies": {
        "prompts": "^2.4.2",
        "ora": "^8.0.1",
        "kleur": "^4.1.5"
    },
    "devDependencies": {
        "@types/node": "^20.0.0",
        "@types/prompts": "^2.4.9",
        "prettier": "^3.6.2",
        "typescript": "^5.0.0"
    },
    "engines": {
        "node": ">=22.10.0"
    }
}
